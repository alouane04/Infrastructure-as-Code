<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>IaC-1 Todo App</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0-beta1/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-0evHe/X+R7YkIZDRvuzKMRqM+OrBnVFBL6DOitfPri4tjfHxaWutUpFmBp4vmVor" crossorigin="anonymous">
</head>

<body>
  <div class="container-fluid">

     {{!-- Server info banner (required by subject) --}}
    <div class="alert alert-secondary d-flex align-items-center py-2 mb-3" role="alert">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-server me-2" viewBox="0 0 16 16">
        <path d="M1.333 2.667C1.333 1.194 4.318 0 8 0s6.667 1.194 6.667 2.667V4c0 1.473-2.985 2.667-6.667 2.667S1.333 5.473 1.333 4zm0 4V4.013c.016.183.08.357.208.52C2.067 5.484 4.814 6.667 8 6.667c3.186 0 5.933-1.183 6.459-2.134.127-.163.191-.337.208-.52V6.68c-.038.143-.149.29-.354.445-.8.578-2.952 1.208-6.313 1.208-3.36 0-5.513-.63-6.313-1.208-.205-.155-.316-.302-.354-.445zm0 2.026c.038.044.078.088.124.13.854.783 3.284 1.51 6.543 1.51 3.26 0 5.69-.727 6.543-1.51.046-.042.086-.086.124-.13V11c0 1.473-2.985 2.667-6.667 2.667S1.333 12.473 1.333 11zm13.334 2.694c-.853.783-3.283 1.51-6.543 1.51-3.26 0-5.69-.727-6.543-1.51A5 5 0 0 1 1.333 13v1.333C1.333 15.806 4.318 17 8 17s6.667-1.194 6.667-2.667V13a5 5 0 0 1-.167.387z"/>
      </svg>
      <small>Served by: <strong>{{serverIp}}</strong></small>
    </div>
    
    <div class="row">
      <h1>{{username}} todos list</h1>
      {{#each todos as |todo|}}
      {{!-- Todo card --}}
      <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
        <div class="card mb-3">
          <div class="card-body">
            <h4 class="card-title">
              {{todo.title}}
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-light">
                {{todo.id}}
              </span>
            </h4>
            <p class="card-text">{{todo.description}}</p>
          </div>
          <div class="card-footer">
            <div class="hstack justify-content-around">
              <input class="todo-checkbox align-middle" type="checkbox" {{#if todo.completed}}checked{{/if}}
                data-todo-id="{{todo.id}}" style="transform: scale(3)" />
              <script>
                document.querySelector('input[data-todo-id="{{todo.id}}"]').addEventListener('change', function (e) {
                  var todoId = +e.target.dataset.todoId;
                  var isCompleted = e.target.checked;
                  var request = new XMLHttpRequest();
                  request.open('PATCH', '/todos/' + todoId);
                  request.setRequestHeader('Content-Type', 'application/json');
                  request.send(JSON.stringify({ completed: isCompleted }));
                });
              </script>
              <button class="todo-delete-button btn btn-danger" data-todo-id="{{todo.id}}">Delete</button>
              <script>
                document.querySelector('button[data-todo-id="{{todo.id}}"]').addEventListener('click', function (e) {
                  var todoId = +e.target.dataset.todoId;
                  var request = new XMLHttpRequest();
                  request.open('DELETE', '/todos/' + todoId);
                  request.send();
                  request.onload = () => {
                    window.location.reload();
                  };
                });
              </script>
            </div>
          </div>
        </div>
      </div>
      {{/each}}
    </div>

    <hr />

    <div class="row justify-content-center">
      <div class="card col-xl-3 col-lg-4 col-md-6 col-sm-8 col-12">
        <div class="card-body">
          <h3 class="card-title">New Todo</h3>
          <form method="POST">
            <input type="text" class="form-control mb-3" name="title" placeholder="Title" />
            <input type="text" class="form-control mb-3" name="description" placeholder="Description" />
            <input type="submit" class="btn btn-success" value="Create todo" />
          </form>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0-beta1/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-pprn3073KE6tl6bjs2QrFaJGz5/SUsLqktiwsUTF55Jfv3qYSDhgCecCxMW52nD2"
      crossorigin="anonymous"></script>
  </div>
</body>

</html>